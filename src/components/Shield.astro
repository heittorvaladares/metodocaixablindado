---
// Ícone do método (escudo com barras subindo).
interface Props { size?: number; color?: string }
const { size = 28, color = "var(--gold)" } = Astro.props;
---
<svg width={size} height={Math.round(size * 56 / 48)} viewBox="0 0 48 56" fill="none" stroke={color} stroke-width="3" stroke-linejoin="round" aria-hidden="true">
  <path d="M24 3 L44 10 V27 C44 40 35 48.5 24 53 C13 48.5 4 40 4 27 V10 Z"></path>
  <path d="M15 40 V33 M24 40 V27 M33 40 V21" stroke-linecap="round"></path>
</svg>
